# Variables of the Railway "api" service (Settings > Variables). Names are exact.
# Copy the keys you need; never commit real values. See docs/deployment/demo-deployment.md.
# Lines marked SECRET must be entered in Railway only.

ASPNETCORE_ENVIRONMENT=Production

# Railway injects PORT; do not define it. The image listens on http://0.0.0.0:$PORT.

# Npgsql connection string assembled from the Railway Postgres reference variables (SECRET).
ConnectionStrings__FieldOpsDatabase=Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};Database=${{Postgres.PGDATABASE}};Username=${{Postgres.PGUSER}};Password=${{Postgres.PGPASSWORD}}

# Public origin of the Vercel site (the first entry is also used for links in emails).
Cors__AllowedOrigins__0=https://REPLACE-WITH-VERCEL-DOMAIN

# Public Railway domain of this service plus the Railway health check host.
AllowedHosts=REPLACE-WITH-RAILWAY-DOMAIN;healthcheck.railway.app

# Proxy trust (Railway edge terminates TLS and overwrites X-Forwarded-*).
ForwardedHeaders__Enabled=true
ForwardedHeaders__TrustAllProxies=true

# Data Protection keys on the Railway volume mounted at /data.
DataProtection__KeysPath=/data/dataprotection
DataProtection__ApplicationName=FieldOps

# Email through Resend.
Email__Provider=Resend
Email__SenderAddress=REPLACE-WITH-VERIFIED-SENDER
Email__SenderName=FieldOps Demo
Email__Resend__ApiKey=REPLACE-IN-RAILWAY-ONLY
# Demo recipient allow-list (exact addresses or @domain). Leave unset for no restriction.
Email__AllowedRecipients__0=REPLACE-WITH-ALLOWED-ADDRESS-OR-@DOMAIN

# Optional: card payments in Stripe TEST mode only (leave unset to keep them disabled).
# Stripe__SecretKey=sk_test_...
# Stripe__PublishableKey=pk_test_...
# Stripe__WebhookSecret=whsec_...

# Optional: bank transfer details encryption key, base64 of 32 random bytes (SECRET).
# BankDetails__EncryptionKey=...
